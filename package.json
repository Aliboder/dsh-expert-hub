{
  "name": "dsh-expert-hub",
  "version": "0.3.1",
  "type": "module",
  "description": "Expert center for DeepSeek Harness: browse and import WorkBuddy experts, create experts with AI, scope them globally or per project, edit role.md and skills, and switch experts per session. · DSH 专家中心：全局/项目专家、WorkBuddy 市场、AI 创建专家、详情即编辑、技能管理、按会话切换。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliboder/dsh-expert-hub.git"
  },
  "homepage": "https://github.com/Aliboder/dsh-expert-hub#readme",
  "bugs": {
    "url": "https://github.com/Aliboder/dsh-expert-hub/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "experts",
    "workbuddy",
    "ai-agent",
    "skills"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/**/*.md",
    "docs/images/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
